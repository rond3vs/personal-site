---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(
    (post) => import.meta.env.DEV || !post.data.draft
  );
  return posts.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const year = entry.data.date.getFullYear();
const { proofTxn, proofHash } = entry.data;
const stampedDate = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<PageLayout title={`${entry.data.title} — LaRon`} back="/blog" backLabel="← Ronny Thoughts">
  <section class="hero hero--blog">
    <span class="app-ico app-ico--blog">
      <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 4h12l4 4v12H4z"/><path d="M8 9h6M8 13h8M8 17h5"/>
      </svg>
    </span>
    <span class="hero-eyebrow">{entry.data.category} · {year}</span>
    <h1>{entry.data.title}</h1>
    <p>{entry.data.description}</p>
  </section>

  <section class="section">
    <div class="prose"><Content /></div>

    {proofTxn && (
      <a
        class="proof"
        href={`https://allo.info/tx/${proofTxn}`}
        target="_blank"
        rel="noopener"
      >
        <span class="proof-lock" aria-hidden="true">🔒</span>
        <span class="proof-text">
          <strong>Timestamped on Algorand</strong>
          <span>Locked in on {stampedDate} — unedited since. View on-chain proof ↗</span>
          {proofHash && <code>sha256: {proofHash}</code>}
        </span>
      </a>
    )}
  </section>
</PageLayout>
