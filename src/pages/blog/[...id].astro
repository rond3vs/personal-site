---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(
    (post) => import.meta.env.DEV || !post.data.draft
  );
  return posts.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const year = entry.data.date.getFullYear();

// Newest stamp first. The first entry attests the *current* text; older ones
// are prior versions whose text lives in git history.
const proofs = [...(entry.data.proofs ?? [])].sort(
  (a, b) => b.date.valueOf() - a.date.valueOf()
);
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
  });
---

<PageLayout title={`${entry.data.title} — LaRon`} back="/blog" backLabel="← Ronny Thoughts">
  <section class="hero hero--blog">
    <span class="app-ico app-ico--blog">
      <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 4h12l4 4v12H4z"/><path d="M8 9h6M8 13h8M8 17h5"/>
      </svg>
    </span>
    <span class="hero-eyebrow">{entry.data.category} · {year}</span>
    <h1>{entry.data.title}</h1>
    <p>{entry.data.description}</p>
  </section>

  <section class="section">
    <div class="prose"><Content /></div>

    {proofs.length > 0 && (
      <aside class="proof" id="post-proof" aria-labelledby="proof-title">
        <div class="proof-main">
          <span class="proof-mark" aria-hidden="true">✓</span>
          <div class="proof-copy">
            <strong id="proof-title">Timestamped on Algorand</strong>
            <p id="proof-status" aria-live="polite">Checking this post against its blockchain record…</p>
          </div>
          <a
            class="proof-link"
            href={`https://allo.info/tx/${proofs[0].txn}`}
            target="_blank"
            rel="noopener"
          >
            View proof <span aria-hidden="true">↗</span>
          </a>
        </div>

        <details class="proof-details">
          <summary>Technical details</summary>
          <div class="proof-meta">
            {proofs.map((p, i) => (
              <div class="proof-record">
                {proofs.length > 1 && (
                  <strong>{i === 0 ? 'Current version' : `Earlier version · ${fmtDate(p.date)}`}</strong>
                )}
                <dl>
                  <div>
                    <dt>Date</dt>
                    <dd>{fmtDate(p.date)}</dd>
                  </div>
                  <div>
                    <dt>Transaction</dt>
                    <dd>
                      <a href={`https://allo.info/tx/${p.txn}`} target="_blank" rel="noopener">
                        {p.txn.slice(0, 10)}…{p.txn.slice(-8)}
                      </a>
                    </dd>
                  </div>
                  <div class="proof-hash">
                    <dt>SHA-256</dt>
                    <dd><code>{p.hash}</code></dd>
                  </div>
                </dl>
              </div>
            ))}
            <p class="proof-note">
              SHA-256 creates a fingerprint of the post. Changing even one character creates a
              different fingerprint.
            </p>
          </div>
        </details>

        <script type="text/plain" id="raw-content">{entry.body}</script>
        <script define:vars={{ expectedHash: proofs[0]?.hash, proofDate: fmtDate(proofs[0].date) }}>
          const rawText = document.getElementById('raw-content').textContent.replace(/\r\n/g, '\n').trim();
          const proof = document.getElementById('post-proof');
          const title = document.getElementById('proof-title');
          const status = document.getElementById('proof-status');

          async function sha256(message) {
            const msgBuffer = new TextEncoder().encode(message.replace(/\r\n/g, '\n').trim());
            const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
            const hashArray = Array.from(new Uint8Array(hashBuffer));
            return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
          }

          async function verify() {
            if (!proof || !title || !status) return;

            try {
              const currentHash = await sha256(rawText);
              const isMatch = currentHash === expectedHash;

              proof.classList.add(isMatch ? 'proof--verified' : 'proof--modified');
              title.textContent = isMatch ? 'Verified on Algorand' : 'Verification failed';
              status.textContent = isMatch
                ? `This post matches its ${proofDate} blockchain timestamp.`
                : 'This page no longer matches the saved blockchain fingerprint.';
            } catch {
              title.textContent = 'Timestamped on Algorand';
              status.textContent = 'This browser could not check the post automatically.';
            }
          }

          verify();
        </script>
      </aside>
    )}
  </section>
</PageLayout>

<style>
  .proof {
    max-width: 62ch;
    margin-top: 32px;
    padding: 16px 0 0;
    border: 0;
    border-top: 1px solid #dedede;
    background: transparent;
    color: var(--ink);
  }
  .proof-main {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
  }
  .proof-mark {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--ink-soft);
    background: var(--card-soft);
    font-size: 14px;
    font-weight: 700;
  }
  .proof-copy strong {
    display: block;
    font-size: 13.5px;
  }
  .proof-copy p {
    margin-top: 2px;
    color: var(--ink-soft);
    font-size: 12.5px;
    line-height: 1.4;
  }
  .proof-link {
    color: var(--accent);
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
  }
  .proof-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  :global(.proof--verified) .proof-mark {
    color: var(--accent);
    background: rgba(32, 106, 93, .1);
  }
  :global(.proof--modified) .proof-mark {
    color: #a33a4d;
    background: rgba(163, 58, 77, .1);
  }
  .proof-details {
    margin: 10px 0 0 38px;
  }
  .proof-details summary {
    width: max-content;
    color: var(--ink-soft);
    cursor: pointer;
    font-size: 12px;
  }
  .proof-details summary:hover {
    color: var(--ink);
  }
  .proof-meta {
    margin-top: 12px;
    padding: 14px;
    border: 1px solid #dedede;
    background: var(--card-soft);
    font-size: 12px;
  }
  .proof-record + .proof-record {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid #dedede;
  }
  .proof-record > strong {
    display: block;
    margin-bottom: 8px;
  }
  .proof-record dl {
    display: grid;
    gap: 7px;
  }
  .proof-record dl > div {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 10px;
  }
  .proof-record dt {
    color: var(--ink-soft);
  }
  .proof-record a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .proof-hash code {
    word-break: break-all;
  }
  .proof-note {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid #dedede;
    color: var(--ink-soft);
    line-height: 1.5;
  }
  @media (max-width: 560px) {
    .proof-main {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .proof-link {
      grid-column: 2;
      justify-self: start;
    }
    .proof-details {
      margin-left: 38px;
    }
    .proof-record dl > div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
