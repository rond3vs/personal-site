---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';


const posts = (await getCollection('blog'))
  .filter((post) => import.meta.env.DEV || !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });

const categories = ['Lessons', 'Hunches', 'Rants'] as const;
const filters = [
  { label: 'All', value: 'all', count: posts.length },
  ...categories.map((c) => ({
    label: c,
    value: c,
    count: posts.filter((p) => p.data.category === c).length,
  })),
  { label: '🔒 Stamped', value: 'stamped', count: posts.filter((p) => p.data.proofs?.length).length },
];
---

<PageLayout title="My Thoughts — LaRon" back="/" backLabel="← Back">
  <section class="hero hero--blog">
    <span class="app-ico app-ico--blog">
      <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 4h12l4 4v12H4z"/><path d="M8 9h6M8 13h8M8 17h5"/>
      </svg>
    </span>
    <h1>My Thoughts</h1>
    <p>Reflections on life and building — written in the open as I figure things out.</p>
  </section>



  <section class="section">
    <div class="filters">
      <label class="filter-label" for="cat-filter">Filter</label>
      <select class="filter-select" id="cat-filter" aria-label="Filter posts by category">
        {filters.map((f) => (
          <option value={f.value}>{f.label} ({f.count})</option>
        ))}
      </select>
    </div>

    {posts.map((post) => (
      <a
        class="entry"
        href={`/blog/${post.id}`}
        data-category={post.data.category}
        data-stamped={post.data.proofs?.length ? 'true' : 'false'}
      >
        <div class="entry-body">
          <div class="entry-top">
            <h3>{post.data.title}</h3>
          </div>
          <p>{post.data.description}</p>
          <div class="entry-meta">
            <time class="entry-date" datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
            <span class="chips">
              <span class="cat-chip">{post.data.category}</span>
              {post.data.proofs?.length ? (
                <span class="cat-chip cat-chip--stamped">🔒 Stamped</span>
              ) : null}
            </span>
          </div>
        </div>
      </a>
    ))}

    <p class="filter-empty" hidden>Nothing here yet.</p>
  </section>
</PageLayout>

<script>
  const select = document.querySelector<HTMLSelectElement>('.filter-select');
  const entries = document.querySelectorAll<HTMLAnchorElement>('.entry[data-category]');
  const empty = document.querySelector<HTMLParagraphElement>('.filter-empty');

  function apply(value: string) {
    let shown = 0;
    entries.forEach((el) => {
      const match =
        value === 'all'
          ? true
          : value === 'stamped'
            ? el.dataset.stamped === 'true'
            : el.dataset.category === value;
      el.hidden = !match;
      if (match) shown++;
    });
    if (empty) empty.hidden = shown > 0;
  }

  select?.addEventListener('change', () => apply(select.value));
</script>
