---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';


const posts = (await getCollection('blog'))
  .filter((post) => import.meta.env.DEV || !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categories = ['Lessons', 'Hunches', 'Strays'] as const;
const filters = [
  { label: 'All', value: 'all', count: posts.length },
  ...categories.map((c) => ({
    label: c,
    value: c,
    count: posts.filter((p) => p.data.category === c).length,
  })),
];
---

<PageLayout title="My Thoughts — LaRon" back="/" backLabel="← Back">
  <section class="hero hero--blog">
    <span class="app-ico app-ico--blog">
      <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 4h12l4 4v12H4z"/><path d="M8 9h6M8 13h8M8 17h5"/>
      </svg>
    </span>
    <h1>My Thoughts</h1>
    <p>Reflections on life and building — written in the open as I figure things out.</p>
  </section>



  <section class="section">
    <div class="filters" role="tablist" aria-label="Filter posts by category">
      {filters.map((f, i) => (
        <button
          class="filter"
          type="button"
          role="tab"
          data-filter={f.value}
          aria-selected={i === 0 ? 'true' : 'false'}
        >
          {f.label} <span class="filter-count">{f.count}</span>
        </button>
      ))}
    </div>

    {posts.map((post) => (
      <a class="entry" href={`/blog/${post.id}`} data-category={post.data.category}>
        <div class="entry-body">
          <div class="entry-top">
            <h3>{post.data.title}</h3>
            <span class="entry-date">{post.data.date.getFullYear()}</span>
          </div>
          <p>{post.data.description}</p>
          <span class="cat-chip">{post.data.category}</span>
        </div>
      </a>
    ))}

    <p class="filter-empty" hidden>Nothing here yet.</p>
  </section>
</PageLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const entries = document.querySelectorAll<HTMLAnchorElement>('.entry[data-category]');
  const empty = document.querySelector<HTMLParagraphElement>('.filter-empty');

  function apply(value: string) {
    let shown = 0;
    entries.forEach((el) => {
      const match = value === 'all' || el.dataset.category === value;
      el.hidden = !match;
      if (match) shown++;
    });
    if (empty) empty.hidden = shown > 0;
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
      apply(btn.dataset.filter ?? 'all');
    });
  });
</script>
