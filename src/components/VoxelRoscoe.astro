---
// Roscoe as isometric voxel art — rendered to a static SVG at build time,
// so it ships as markup with no runtime JS or dependencies.
//
// Self-contained (card frame, caption, and styles included). To show him
// anywhere, import and drop in:
//   import VoxelRoscoe from '../components/VoxelRoscoe.astro';
//   <VoxelRoscoe />
//
// The model is a list of [x, y, z, color] voxels; +x is the way he faces,
// z is up. Faces are drawn back-to-front (painter's algorithm), with the
// top face lightened and the two visible sides darkened for depth.

const PALETTE = {
  tan:   '#c9a15e',
  gold:  '#a87f3f',
  steel: '#5f6470',
  cream: '#e6d3a3',
  dark:  '#2b2723',
  green: '#206a5d',
};

const voxels = [];
const add = (x, y, z, c) => voxels.push([x, y, z, c]);

// legs
for (const [x, y] of [[1, 1], [1, 3], [5, 1], [5, 3]]) {
  add(x, y, 0, 'tan');
  add(x, y, 1, 'tan');
}
// body — tan belly with a steel "saddle" on his back, yorkie style
for (let x = 1; x <= 5; x++)
  for (let y = 1; y <= 3; y++) {
    add(x, y, 2, 'tan');
    add(x, y, 3, 'steel');
  }
// tail, tipped in cream
add(0, 2, 3, 'steel');
add(0, 2, 4, 'cream');
// collar layer — green band under the head, tan chin at the front
for (let x = 4; x <= 6; x++)
  for (let y = 1; y <= 3; y++) add(x, y, 4, y === 2 && x >= 5 ? 'tan' : 'green');
// head, with eyes on the front corners
for (let x = 4; x <= 6; x++)
  for (let y = 1; y <= 3; y++) {
    add(x, y, 5, x === 6 && y !== 2 ? 'dark' : 'tan');
    add(x, y, 6, 'tan');
  }
// perky ears and a little black nose, sitting below the eyes
add(4, 1, 7, 'gold');
add(4, 3, 7, 'gold');
add(7, 2, 4, 'dark');

// --- isometric projection ---
const S = 13; // voxel size
const W = (Math.sqrt(3) / 2) * S;
const H = S / 2;
const p = (x, y, z) => [(x - y) * W, (x + y) * H - z * S];

const shade = (hex, f) => {
  const n = parseInt(hex.slice(1), 16);
  const t = f < 0 ? 0 : 255;
  const a = Math.abs(f);
  const ch = (v) => Math.round(v + (t - v) * a);
  const [r, g, b] = [ch((n >> 16) & 255), ch((n >> 8) & 255), ch(n & 255)];
  return '#' + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
};

voxels.sort((a, b) => a[0] + a[1] + a[2] - (b[0] + b[1] + b[2]));

const faces = [];
for (const [x, y, z, c] of voxels) {
  const col = PALETTE[c];
  faces.push(
    [[p(x, y, z + 1), p(x + 1, y, z + 1), p(x + 1, y + 1, z + 1), p(x, y + 1, z + 1)], shade(col, 0.22)],
    [[p(x, y + 1, z), p(x + 1, y + 1, z), p(x + 1, y + 1, z + 1), p(x, y + 1, z + 1)], shade(col, -0.12)],
    [[p(x + 1, y, z), p(x + 1, y + 1, z), p(x + 1, y + 1, z + 1), p(x + 1, y, z + 1)], shade(col, -0.34)],
  );
}

const xs = faces.flatMap(([pts]) => pts.map((q) => q[0]));
const ys = faces.flatMap(([pts]) => pts.map((q) => q[1]));
const pad = 4;
const minX = Math.min(...xs) - pad;
const minY = Math.min(...ys) - pad;
const vbW = Math.max(...xs) + pad - minX;
const vbH = Math.max(...ys) + pad - minY;
---

<div class="card card--voxel">
  <figure class="voxel-stage">
    <svg
      viewBox={`${minX.toFixed(2)} ${minY.toFixed(2)} ${vbW.toFixed(2)} ${vbH.toFixed(2)}`}
      role="img"
      aria-label="Voxel art of Roscoe, a little yorkie"
    >
      {faces.map(([pts, fill]) => (
        <polygon
          points={pts.map((q) => q.map((n) => +n.toFixed(2)).join(',')).join(' ')}
          fill={fill}
          stroke={fill}
          stroke-width="0.5"
          stroke-linejoin="round"
        />
      ))}
    </svg>
  </figure>
  <p class="voxel-caption">Roscoe &middot; 13 years a good boy</p>
</div>

<style>
  .card--voxel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 26px 16px 16px;
  }
  /* notch label, matching the other home cards */
  .card--voxel::before {
    content: "[ roscoe.vox ]";
    position: absolute;
    top: 0; left: 18px;
    transform: translateY(-50%);
    background: var(--bg);
    padding: 0 8px;
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .voxel-stage svg {
    width: 168px;
    height: auto;
    animation: voxel-bob 3.4s ease-in-out infinite;
  }
  @keyframes voxel-bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-4px); }
  }
  .voxel-caption {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  @media (prefers-reduced-motion: reduce) {
    .voxel-stage svg { animation: none; }
  }
</style>
